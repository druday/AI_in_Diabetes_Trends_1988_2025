# Copy this file to `.env` and fill in your own credentials.
# Never commit a real `.env` or any real API keys.

# Required by Entrez / NCBI E-utilities (PubMed retrieval)
NCBI_EMAIL=your-email@example.com

# Optional: raises NCBI E-utilities rate limits
NCBI_API_KEY=

# Required only to re-run the optional LLM affiliation-classification sidecar
OPENAI_API_KEY=
